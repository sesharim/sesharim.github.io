# frozen_string_literal: true

require "cgi"
require "pathname"
require "uri"

SITE_ROOT = Pathname("_site")
PUBLIC_ORIGIN = "https://lukin.io"
PUBLIC_HOST = "lukin.io"

errors = []

unless SITE_ROOT.directory?
  warn "SEO audit failed: _site does not exist. Build the site first."
  exit 1
end

def public_path_for(file)
  relative = file.relative_path_from(SITE_ROOT).to_s

  return "/" if relative == "index.html"
  return "/#{relative.delete_suffix("index.html")}" if relative.end_with?("/index.html")

  "/#{relative.delete_suffix(".html")}"
end

def tag_count(html, tag_name, attribute = nil, value = nil)
  tags = html.scan(/<#{tag_name}\b[^>]*>/i)
  return tags.length unless attribute && value

  tags.count do |tag|
    tag.match?(/\b#{Regexp.escape(attribute)}\s*=\s*["']#{Regexp.escape(value)}["']/i)
  end
end

def internal_target_exists?(path)
  clean_path = path.sub(%r{\A/}, "")
  candidates = []

  if clean_path.empty?
    candidates << SITE_ROOT.join("index.html")
  else
    candidates << SITE_ROOT.join(clean_path)

    if File.extname(clean_path).empty?
      candidates << SITE_ROOT.join("#{clean_path}.html")
      candidates << SITE_ROOT.join(clean_path, "index.html")
    elsif clean_path.end_with?("/")
      candidates << SITE_ROOT.join(clean_path, "index.html")
    end
  end

  candidates.any?(&:file?)
end

html_files = SITE_ROOT.glob("**/*.html")

html_files.each do |file|
  html = file.read
  next unless html.match?(/<html\b/i)

  public_path = public_path_for(file)
  title_count = tag_count(html, "title")
  description_count = tag_count(html, "meta", "name", "description")
  canonical_count = tag_count(html, "link", "rel", "canonical")
  keywords_count = tag_count(html, "meta", "name", "keywords")

  errors << "#{public_path}: expected 1 <title>, found #{title_count}" unless title_count == 1
  errors << "#{public_path}: expected 1 meta description, found #{description_count}" unless description_count == 1
  errors << "#{public_path}: expected 1 canonical link, found #{canonical_count}" unless canonical_count == 1
  errors << "#{public_path}: obsolete meta keywords tag is present" unless keywords_count.zero?

  if html.include?("filecite") || html.match?(/turn\d+file\d+/)
    errors << "#{public_path}: internal citation artifact leaked into generated HTML"
  end

  html.scan(/<a\b[^>]*\bhref\s*=\s*(["'])(.*?)\1/i).each do |_quote, raw_href|
    href = CGI.unescapeHTML(raw_href.strip)
    next if href.empty? || href.start_with?("#")
    next if href.include?("${") || href.include?("{{") || href.include?("{%")
    next if href.match?(%r{\A(?:mailto|tel|javascript|data):}i)
    next if href.start_with?("//")

    begin
      resolved = URI.join("#{PUBLIC_ORIGIN}#{public_path}", href)
    rescue URI::InvalidURIError
      errors << "#{public_path}: invalid href #{href.inspect}"
      next
    end

    next if resolved.host && resolved.host != PUBLIC_HOST
    next unless %w[http https].include?(resolved.scheme)

    target_path = resolved.path
    next if internal_target_exists?(target_path)

    errors << "#{public_path}: broken internal link #{href.inspect} -> #{target_path}"
  end
end

search_file = SITE_ROOT.join("search.html")
if search_file.file?
  search_html = search_file.read
  robots_tags = search_html.scan(/<meta\b[^>]*\bname\s*=\s*["']robots["'][^>]*>/i)
  unless robots_tags.any? { |tag| tag.match?(/\bcontent\s*=\s*["'][^"']*noindex[^"']*["']/i) }
    errors << "/search: expected a robots noindex directive"
  end
else
  errors << "/search: generated search page is missing"
end

sitemap_file = SITE_ROOT.join("sitemap.xml")
if sitemap_file.file?
  sitemap = sitemap_file.read
  if sitemap.match?(%r{<loc>https://lukin\.io/search/?</loc>}i)
    errors << "sitemap.xml: /search must not be submitted for indexing"
  end
else
  errors << "sitemap.xml is missing"
end

robots_file = SITE_ROOT.join("robots.txt")
if robots_file.file?
  robots = robots_file.read
  unless robots.include?("Sitemap: https://lukin.io/sitemap.xml")
    errors << "robots.txt: sitemap declaration is missing"
  end
else
  errors << "robots.txt is missing"
end

if errors.empty?
  puts "SEO audit passed: #{html_files.length} generated HTML files checked."
  exit 0
end

warn "SEO audit failed with #{errors.length} issue#{errors.length == 1 ? "" : "s"}:"
errors.each { |error| warn "- #{error}" }
exit 1
